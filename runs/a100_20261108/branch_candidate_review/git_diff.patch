+def _im2col_gpu(img, kernel_size, stride, pad):
+    """im2col function for GPU.
+    This code is ported from Chainer:
+    https://github.com/chainer/chainer/blob/v6.4.0/chainer/utils/conv.py
+    """
+    n, c, h, w = img.shape
+    kh, kw = pair(kernel_size)
+    sy, sx = pair(stride)
+    ph, pw = pair(pad)
+    out_h = get_conv_outsize(h, kh, sy, ph)
+    out_w = get_conv_outsize(w, kw, sx, pw)
+    dy, dx = 1, 1
+    col = cuda.cupy.empty((n, c, kh, kw, out_h, out_w), dtype=img.dtype)
+
+    cuda.cupy.ElementwiseKernel(
+        'raw T img, int32 h, int32 w, int32 out_h, int32 out_w,'
+        'int32 kh, int32 kw, int32 sy, int32 sx, int32 ph, int32 pw,'
+        'int32 dy, int32 dx',
+        'T col',
+        '''
+           int c0 = i / (kh * kw * out_h * out_w);
+           int ky = i / (kw * out_h * out_w) % kh;
+           int kx = i / (out_h * out_w) % kw;
+           int out_y = i / out_w % out_h;
+           int out_x = i % out_w;
+           int in_y = ky * dy + out_y * sy - ph;
+           int in_x = kx * dx + out_x * sx - pw;
+           if (in_y >= 0 && in_y < h && in_x >= 0 && in_x < w) {
+             col = img[in_x + w * (in_y + h * c0)];
+           } else {
+             col = 0;
+           }
+        ''',
+        'im2col')(img.reduced_view(),
+                  h, w, out_h, out_w, kh, kw, sy, sx, ph, pw, dy, dx, col)
+
+    return col
+
+
+def _col2im_gpu(col, sy, sx, ph, pw, h, w):
+    """col2im function for GPU.
+    This code is ported from Chainer:
+    https://github.com/chainer/chainer/blob/v6.4.0/chainer/utils/conv.py
+    """
+    n, c, kh, kw, out_h, out_w = col.shape
+    dx, dy = 1, 1
+    img = cuda.cupy.empty((n, c, h, w), dtype=col.dtype)
+
+    cuda.cupy.ElementwiseKernel(
+        'raw T col, int32 h, int32 w, int32 out_h, int32 out_w,'
+        'int32 kh, int32 kw, int32 sy, int32 sx, int32 ph, int32 pw,'
+        'int32 dx, int32 dy',
+        'T img',
+        '''
+           int c0 = i / (h * w);
+           int y  = i / w % h;
+           int x  = i % w;
+           T val = 0;
+           for (int ky = 0; ky < kh; ++ky) {
+             int out_y = (y + ph - ky * dy);
+             if (0 > out_y || out_y >= out_h * sy) continue;
+             if (out_y % sy != 0) continue;
+             out_y /= sy;
+             for (int kx = 0; kx < kw; ++kx) {
+               int out_x = (x + pw - kx * dx);
+               if (0 > out_x || out_x >= out_w * sx) continue;
+               if (out_x % sx != 0) continue;
+               out_x /= sx;
+               int k = out_y + out_h * (kx + kw * (ky + kh * c0));
+               val = val + col[out_x + out_w * k];
+             }
+           }
+           img = val;
+        ''',
+        'col2im')(col.reduced_view(),
+                  h, w, out_h, out_w, kh, kw, sy, sx, ph, pw, dx, dy, img)
+    return img
+
+
+# =========================================================
+# Batch Normalization (for Conv2d feature maps)
+# =========================================================
+
+
+class BatchNorm(Function):
+    def __init__(self, mean, var, eps=1e-5):
+        self.mean = mean
+        self.var = var
+        self.eps = eps
+        self.std = None
+
+    def forward(self, x):
+        xp = cuda.get_array_module(x)
+        mean = xp.asarray(self.mean)
+        var = xp.asarray(self.var)
+        self.std = xp.sqrt(var + self.eps)         # ndarray
+        y = (x - mean) / self.std
+        return y                                    # ndarray
+
+    def backward(self, gy):
+        # ---- 全部用 Variable 运算，且对 (N,H,W) 维聚合 ----
+        x = self.inputs[0]                         # Variable
+        axes = (0, 2, 3)                            # sum over N,H,W，保留C
+        N_HW = x.shape[0] * x.shape[2] * x.shape[3] # 标量
+
+        # 把前向保存的均值/标准差包成常量 Variable（与 x 同设备）
+        xp = cuda.get_array_module(x.data)
+        mean = as_variable(xp.asarray(self.mean))  # shape=(1,C,1,1)
+        std = as_variable(xp.asarray(self.std))   # shape=(1,C,1,1)
+
+        x_mu = x - mean
+        std_inv = 1.0 / std
+
+        # 关键：用 hytorch.functions.sum，对 Variable 求和
+        sum_gy = sum(gy, axis=axes, keepdims=True)
+        sum_gy_xmu = sum(gy * x_mu, axis=axes, keepdims=True)
+
+        # BN conv 版的梯度公式（Variable 版）
+        gx = (1.0 / N_HW) * std_inv * (
+                N_HW * gy
+              - sum_gy
+              - x_mu * (std_inv ** 2) * sum_gy_xmu
+        )
+        return gx
+
+
+def batch_norm(x, gamma, beta, running_mean, running_var, eps=1e-5, momentum=0.9):
+    xp = cuda.get_array_module(x.data)
+
+    if Config.train:
+        mean = x.data.mean(axis=(0, 2, 3), keepdims=True)  # 与 x 同设备
+        var = x.data.var(axis=(0, 2, 3), keepdims=True)  # 与 x 同设备
+
+        # 原地更新滑动均值方差（与 x 同设备，且与 running_mean/var 同设备）
+        running_mean[...] = momentum * running_mean + (1 - momentum) * mean
+        running_var[...] = momentum * running_var + (1 - momentum) * var
+    else:
+        mean = running_mean
+        var = running_var
+
+    y = BatchNorm(mean, var, eps)(x)  # -> Variable
+    return gamma * y + beta  # 线性变换
+
