+# 评估精度的函数，用的是ndarray，不能对其求导
+def accuracy(y, t):
+    y, t = as_variable(y), as_variable(t)
+
+    pred = y.data.argmax(axis=1).reshape(t.shape)
+    result = (pred == t.data)
+    acc = result.mean()
+    return as_variable(as_array(acc))
